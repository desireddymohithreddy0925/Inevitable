# Inevitable Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Backend Configuration
# =============================================================================

# Server
BACKEND_HOST=localhost
BACKEND_PORT=8000

# CORS (if needed)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# =============================================================================
# AI Model Integration - GEMMA 4
# =============================================================================

# Note: Replace with your actual Gemma 4 provider configuration
# Available providers: huggingface_hub, together.ai, vllm, etc.

# Provider type (huggingface, together, vllm, local)
GEMMA_PROVIDER=together

# Your API key for the selected provider
# Get one at: https://api.together.xyz/ (or your provider's equivalent)
TOGETHER_API_KEY=

# Gemma 4 model identifier (verified from provider documentation)
# Example values based on provider:
# - together.ai: "together/gemma-4" or provider-specific ID
# - huggingface_hub: specific model repo path
# Adjust this to match your Gemma 4 access method
GEMMA_MODEL_ID=

# Model timeout in seconds
MODEL_TIMEOUT=120

# Model max retries
MODEL_MAX_RETRIES=3

# =============================================================================
# Demo Repository (for controlled testing)
# =============================================================================

# Path to demo repository with known bug (used when real repo access is blocked)
DEMO_REPO_PATH=./demo_repo

# =============================================================================
# Execution Limits
# =============================================================================

# Max CPU usage for test execution (0.1 = 10% of one core, default: 0.2)
EXECUTION_CPU_LIMIT=0.2

# Max memory in GB for test execution (default: 0.5)
EXECUTION_MEMORY_LIMIT_GB=0.5

# Max time in seconds for a single test run (default: 30)
EXECUTION_TIMEOUT_SECONDS=30

# =============================================================================
# Frontend Configuration
# =============================================================================

# API endpoint for frontend to connect to
VITE_API_URL=http://localhost:8000
