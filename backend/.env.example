# Inevitable Backend Environment Configuration
# Copy this file to .env and adjust as needed

# Host and Port configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration
# In production, replace with actual frontend domain, e.g., ["https://inevitable.demo.com"]
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# AI Provider Configuration
# Set to "together" for production, "mock" for local testing without API key
GEMMA_PROVIDER=mock
# Required if GEMMA_PROVIDER=together
TOGETHER_API_KEY=your-secure-api-key-here
GEMMA_MODEL_ID=google/gemma-4-preview

# Execution Limits
MODEL_TIMEOUT=120
# CAUTION: Enabling untrusted execution allows arbitrary code execution in the pytest sandbox.
# Do not enable this in public production without a proper seccomp/cgroup sandbox!
ENABLE_UNTRUSTED_EXECUTION=false
